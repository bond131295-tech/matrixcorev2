<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:padding="14dp" android:background="@drawable/bg_widget">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="operator@flip5 ~ $ date" android:textColor="#35F07A" android:textSize="11sp"
        android:fontFamily="monospace" />
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textColor="#E8F2EC"
        android:textSize="46sp" android:textStyle="bold" android:fontFamily="monospace" />
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEE, d MMM yyyy" android:format24Hour="EEE, d MMM yyyy" android:textColor="#7C8E84"
        android:textSize="12sp" android:fontFamily="monospace" />
</LinearLayout>
